{
  "name": "sales-research-firecrawl",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local Firecrawl-powered website research workspace for sales teams.",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "dev": "node --env-file-if-exists=.env --watch server.mjs",
    "test": "node --test",
    "test:e2e": "playwright test",
    "crm:session": "node scripts/create-crm-session.mjs",
    "leads:google:nationwide": "node --env-file-if-exists=.env.local scripts/google-places-nationwide.mjs",
    "leads:tutors:enrich": "node scripts/enrich-tutor-subjects.mjs",
    "seed:neon": "node --env-file-if-exists=.env.local scripts/seed-neon.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0"
  }
}
